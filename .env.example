# Copy to .env locally. Never commit .env or paste credentials into chat.
POSTGRES_PASSWORD=replace-with-random-local-password
# URL-encode special characters in the password. Host-run development URL:
DATABASE_URL=postgresql+psycopg://quarterdeck:replace-with-random-local-password@127.0.0.1:5433/quarterdeck
# Models are chosen in the browser (Settings -> Models): add a provider, paste
# its key (stored encrypted on this computer), and choose a model per role.
# An office upgraded from the LiteLLM gateway has its CHIEF_MODEL/CHIEF_API_KEY
# (and RESEARCH_, STRATEGY_, CRITIC_) adopted as connections by scripts.upgrade.

# Search provider for the Researcher: 'static' (no results; tests only), 'brave',
# 'exa', 'tavily' or 'deepseek' (DeepSeek's Search API; uses DEEPSEEK_API_KEY when
# SEARCH_API_KEY is empty).
SEARCH_PROVIDER=static
SEARCH_API_KEY=
# DeepSeek's Search and Fetch APIs. FETCH_FALLBACK=deepseek reads a page through
# DeepSeek only when the office's own reader cannot; 'none' keeps every read local.
DEEPSEEK_API_KEY=
FETCH_FALLBACK=none
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT_SECONDS=20

# The Researcher reads the pages it cites so it can quote primary sources.
ENABLE_PAGE_FETCH=true
FETCH_MAX_PAGES=5
FETCH_TIMEOUT_SECONDS=15

CHIEF_MODEL_ALIAS=0001
RESEARCH_MODEL_ALIAS=0002
STRATEGY_MODEL_ALIAS=0003
CRITIC_MODEL_ALIAS=0004
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=16000
# Output cap for long-form deliverables (strategy/summary writing) only.
DELIVERABLE_MAX_OUTPUT_TOKENS=16384
STRUCTURED_OUTPUT_ATTEMPTS=3
# Default budget per run: tokens (all model calls, retries included), optional
# dollar cost (gateway-reported prices only), and minutes of active execution.
RUN_MAX_TOKENS=400000
RUN_MAX_COST_USD=
RUN_MAX_MINUTES=30
# Parallel research subtasks run at most this many at once.
MAX_PARALLEL_SUBTASKS=4
# Tasks the worker runs at the same time (1-8); Settings → Models can change it.
MAX_CONCURRENT_RUNS=3
# Mobile access, home network: set by `python3 -m scripts.access home`.
# 127.0.0.1 keeps the office on this computer only.
OFFICE_BIND=127.0.0.1
OFFICE_LAN_ADDRESSES=
# Mobile access, remote: the remote container's exchange folder. Compose sets
# it; leave empty when running the office outside Docker.
REMOTE_EXCHANGE=
# Slack conversation: daily token allowance (separate from run budgets) and reply length.
CHAT_DAILY_MAX_TOKENS=200000
CHAT_MAX_OUTPUT_TOKENS=4096
MAX_REVISION_LOOPS=3
# Shown to agents as the organization in every run's context.
OFFICE_NAME=Quarterdeck
# Optional: TypeSafe key for semantic judgments (convergence, criterion reachability).
TYPESAFE_API_KEY=
OWNER_NAME=Alex
OWNER_API_TOKEN=replace-with-random-owner-token
# Coding runs on this Mac, by Quarterdeck Coder (scripts/mac_coder.py), with your
# own CLI's sign-in; the office runs no coding agent itself (Stage 36). How long
# the office's own checks of a coding task may run, and the CLI it starts with
# (claude_code, codex, opencode or dsh) until you choose one in Settings.
CODEX_TIMEOUT_SECONDS=900
CODING_AGENT=claude_code

# Engineering target. What may change is configured here, not proposed by a
# model. Leave the repository empty to keep engineering unavailable.
ENGINEERING_REPOSITORY=
ENGINEERING_BASE_BRANCH=main
ENGINEERING_TEST_COMMAND=
ENGINEERING_PERMITTED_PATHS=

# Forge publication. Create a PROJECT access token (scopes: api,
# write_repository) on the project itself, not a personal access token.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_PATH=
GITLAB_TOKEN=
FORGE_TIMEOUT_SECONDS=30

WORKSPACE_ROOT=workspace
# Host folder the office may read (mounted read-only into the no-network sources
# service). Register subfolders of it as knowledge sources in the browser.
LOCAL_SOURCES_DIR=./sources
# Exchange directory shared with the sources service. Compose sets /sources-exchange.
SOURCES_EXCHANGE=sources-exchange
# Pages are read by the no-credential fetch service through this exchange.
# Compose sets /fetch-exchange; empty means the office reads them itself.
FETCH_EXCHANGE=
# Where the office asks its own sandboxed browser (CU1). Set by Docker Compose;
# empty leaves the browser off for an office run without it.
BROWSER_EXCHANGE=
# Optional: only these hosts may be read, comma separated.
FETCH_ALLOW_HOSTS=
# Engineering clones. Blank uses WORKSPACE_ROOT/engineering; Compose sets /engineering.
ENGINEERING_WORKSPACE=
# isolated: repository tests run in the no-network runner service. local: in-process (dev only).
ENGINEERING_TEST_RUNNER=isolated
# Backup archives (scripts.backup). Compose writes them to ./backups on the host.
BACKUP_DIR=backups
# Encrypted provider credentials. Blank uses WORKSPACE_ROOT/secrets/credentials.json.
SECRET_STORE_PATH=
# Root key for the credential store, generated by `python -m scripts.init_local`.
# Keep it out of backups of the store; losing it means re-entering credentials.
SECRET_KEY_FILE=.secrets/root.key
ENABLE_CODE_EXECUTION=false
ENABLE_GITHUB_PR=false
# Coding agents may change files in a space's folders, on office/<thread> branches,
# merging only with your approval (Stage 6d). Needs a writable mount of the
# approved root; leave false until you choose to turn it on.
WORKSPACES_WRITABLE=false
# Where the root is mounted writable inside the api container, e.g. /workspaces-rw,
# after adding a volume "- ~/dev:/workspaces-rw" to the api service yourself.
WORKSPACES_WRITE_ROOT=
ENABLE_PRODUCTION_DEPLOYMENT=false
